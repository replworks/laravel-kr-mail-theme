{
    "name": "replworks/laravel-kr-mail-theme",
    "description": "Laravel mail theme package for Korean-market services.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0|^13.0",
        "league/commonmark": "^2.0",
        "tijsverkoyen/css-to-inline-styles": "^2.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Replworks\\KrMailTheme\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Replworks\\KrMailTheme\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Replworks\\KrMailTheme\\KrMailThemeServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
